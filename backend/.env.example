APP_ENV=development
DATABASE_URL=postgresql+psycopg://ntech_ems:CHANGE_ME@127.0.0.1:5432/ntech_ems
TEST_DATABASE_URL=postgresql+psycopg://ntech_ems:CHANGE_ME@127.0.0.1:5432/ntech_ems_test
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
# Generate independently; preserve this key and the MFA key outside database backups.
BACKUP_ENCRYPTION_KEY=GENERATE_A_SEPARATE_BACKUP_KEY
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173"]
COOKIE_SECURE=false
SESSION_HOURS=8
PUBLIC_URL=http://127.0.0.1:5173

# Optional dedicated Fernet key for SMTP credentials. Set before the first save.
# If omitted, MFA_ENCRYPTION_KEY is used. Preserve the effective key with backups.
# SMTP_ENCRYPTION_KEY=
# Optional initial defaults, used only until the CEO saves configuration in Settings.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_SENDER_NAME=NTECH EMS
# SMTP_SENDER_EMAIL=
# SMTP_USERNAME=
# SMTP_PASSWORD=
