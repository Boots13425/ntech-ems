{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "noUnusedLocals": true, "noUnusedParameters": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "baseUrl": ".", "paths": {"@/*": ["./src/*"]}, "types": ["vite/client", "vite-plugin-pwa/react"]
  },
  "include": ["src", "vite.config.ts"]
}
