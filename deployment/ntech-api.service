[Unit]
Description=NTECH EMS API
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
Type=simple
User=ntech
Group=ntech
WorkingDirectory=/srv/ntech-ems/backend
EnvironmentFile=/etc/ntech-ems/backend.env
ExecStart=/srv/ntech-ems/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
[Install]
WantedBy=multi-user.target
